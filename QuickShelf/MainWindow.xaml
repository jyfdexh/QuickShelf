<Window x:Class="QuickShelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QuickShelf"
        Width="1240"
        Height="740"
        MinWidth="1120"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Icon="Assets/AppIcon.ico"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        x:Name="RootWindow">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#111827" />
        <SolidColorBrush x:Key="SubTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D6E6F8" />
        <SolidColorBrush x:Key="BlueBrush" Color="#2F7CF6" />
        <SolidColorBrush x:Key="WindowRootBrush" Color="#DDF8FBFF" />
        <SolidColorBrush x:Key="PrimaryPanelBrush" Color="#CFF8FBFF" />
        <SolidColorBrush x:Key="SecondaryPanelBrush" Color="#DDF8FBFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputBrush" Color="#F7FBFF" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#D5E3F6" />
        <SolidColorBrush x:Key="MutedPanelBrush" Color="#E4F0FF" />
        <SolidColorBrush x:Key="StatusPanelBrush" Color="#BFF7FBFF" />
        <SolidColorBrush x:Key="StatusBorderBrush" Color="#DCE9F8" />
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F7FF" />
        <SolidColorBrush x:Key="SelectedBrush" Color="#E7F0FF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#EEF2F7" />
        <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />

        <DropShadowEffect x:Key="SoftShadow"
                          BlurRadius="18"
                          ShadowDepth="6"
                          Direction="270"
                          Opacity="0.12"
                          Color="#355A8A" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
        </Style>

        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ShowsPreview" Value="False" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border x:Name="Track"
                                    Width="3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="3"
                                    Background="{DynamicResource DividerBrush}"
                                    Margin="0,54,0,54" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Width" Value="6" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PanelBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="154" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{DynamicResource BlueBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="PlainButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#F7FBFF" />
        </Style>

        <Style x:Key="CompactActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Width" Value="86" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="46"
                                Height="28"
                                Background="#E5E7EB"
                                CornerRadius="14">
                            <Border x:Name="Thumb"
                                    Width="24"
                                    Height="24"
                                    Margin="2"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    CornerRadius="12"
                                    Effect="{StaticResource SoftShadow}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IOSSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}"
                                                  Background="{DynamicResource BlueBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderTrackButtonStyle}"
                                                  Background="#E5EAF2" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="22"
                                           Height="22"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="White"
                                                        BorderBrush="#CAD5E4"
                                                        BorderThickness="1"
                                                        CornerRadius="11"
                                                        Effect="{StaticResource SoftShadow}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteToolTipStyle" TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Mouse" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12,10"
                                Effect="{StaticResource SoftShadow}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="MinWidth" Value="178" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="6"
                                Effect="{StaticResource SoftShadow}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderHost"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderHost" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerFavoriteContextMenuItemStyle"
               TargetType="MenuItem"
               BasedOn="{StaticResource FavoriteContextMenuItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <Style x:Key="FavoriteContextMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource DividerBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupChipListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource FavoriteContextMenuStyle}">
                        <MenuItem Header="重命名"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="RenameFavoriteGroupMenuItem_Click" />
                        <MenuItem Header="删除"
                                  Style="{StaticResource DangerFavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="DeleteFavoriteGroupMenuItem_Click" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource BlueBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupChipTemplate">
            <TextBlock Text="{Binding}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FavoriteTileTemplate">
            <Grid Width="{Binding StackTileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding StackTileHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="2"
                  Cursor="Hand"
                  PreviewMouseRightButtonDown="FavoriteTile_PreviewMouseRightButtonDown">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource FavoriteToolTipStyle}">
                        <StackPanel MinWidth="220" MaxWidth="420">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Path}"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource FavoriteContextMenuStyle}">
                        <MenuItem Header="移除"
                                  Style="{StaticResource DangerFavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="RemoveFavoriteMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="打开"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="OpenFavoriteMenuItem_Click" />
                        <MenuItem Header="以管理员身份启动"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="RunFavoriteAsAdminMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="打开所在位置"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="OpenFavoriteLocationMenuItem_Click" />
                        <MenuItem Header="复制路径"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="CopyFavoritePathMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="修改备注"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="EditFavoriteDisplayNameMenuItem_Click" />
                        <MenuItem Header="清除备注"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="ClearFavoriteDisplayNameMenuItem_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Width="{Binding StackIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                        Height="{Binding StackIconFrameSize, RelativeSource={RelativeSource AncestorType=Window}}"
                        CornerRadius="13"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Effect="{StaticResource SoftShadow}">
                    <Image Source="{Binding IconPath}"
                           Width="{Binding StackIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding StackIconImageSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Grid.Row="1"
                           Text="{Binding DisplayTitle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,6,0,0"
                           FontSize="{Binding StackTileFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FolderItemTemplate">
            <Grid MinHeight="48"
                  Margin="4,2"
                  PreviewMouseRightButtonDown="FolderItem_PreviewMouseRightButtonDown">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource FavoriteToolTipStyle}">
                        <StackPanel MinWidth="220" MaxWidth="420">
                            <TextBlock Text="{Binding DisplayTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Path}"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource SubTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource FavoriteContextMenuStyle}">
                        <MenuItem Header="移除"
                                  Style="{StaticResource DangerFavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="RemoveFolderMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="打开"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="OpenFolderMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="打开所在位置"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="OpenFolderLocationMenuItem_Click" />
                        <MenuItem Header="复制路径"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="CopyFolderPathMenuItem_Click" />
                        <Separator Style="{StaticResource FavoriteContextMenuSeparatorStyle}" />
                        <MenuItem Header="修改备注"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="EditFolderDisplayNameMenuItem_Click" />
                        <MenuItem Header="清除备注"
                                  Style="{StaticResource FavoriteContextMenuItemStyle}"
                                  CommandParameter="{Binding}"
                                  Click="ClearFolderDisplayNameMenuItem_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="32"
                        Height="32"
                        CornerRadius="8"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image Source="{Binding IconPath}" Width="26" Height="26" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RecentItemTemplate">
            <Grid MinHeight="52" Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Border Width="34"
                        Height="34"
                        CornerRadius="8"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image Source="{Binding IconPath}" Width="28" Height="28" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Content="+"
                        FontSize="20"
                        Foreground="{DynamicResource BlueBrush}"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        Cursor="Hand"
                        ToolTip="加入堆栈"
                        Click="AddRecentFileButton_Click" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AllItemTemplate">
            <Grid MinHeight="58" Margin="6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        CornerRadius="9"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Image Source="{Binding IconPath}" Width="30" Height="30" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Path}"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="12"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="32"
                        Height="32"
                        Content="+"
                        FontSize="23"
                        Foreground="{DynamicResource BlueBrush}"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource ToolbarBorderBrush}"
                        Cursor="Hand"
                        Click="AddFromAllItemButton_Click" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="GlassRoot"
            CornerRadius="28"
            Background="{DynamicResource WindowRootBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
            SizeChanged="GlassRoot_SizeChanged"
            MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
        <Grid Margin="28,12,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="18" />
                    <RowDefinition Height="82" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-10,-14,0">
                    <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" ToolTip="最小化" Click="MinimizeWindow_Click" />
                    <Button x:Name="MaximizeRestoreButton"
                            Content="&#xE922;"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="最大化"
                            Click="ToggleMaximize_Click" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" ToolTip="关闭到托盘" Click="CloseWindow_Click" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="50,0,0,0">
                        <Border x:Name="AppLogoBackground"
                                Width="58"
                                Height="58"
                                CornerRadius="14"
                                Background="{DynamicResource BlueBrush}"
                                Effect="{StaticResource SoftShadow}">
                            <Grid>
                                <Ellipse Width="42" Height="42" Stroke="#BFD6FF" StrokeThickness="3" Opacity="0.72" />
                                <Ellipse Width="18" Height="18" Fill="#DDEBFF" />
                                <Path Data="M29,35 C29,24 38,24 38,35"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="0,0,0,-10" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="24,6,0,0">
                            <TextBlock Text="QuickShelf"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="快速创建并启动你的应用堆栈"
                                       Margin="0,6,0,0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="RecentFilesButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="RecentFilesButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◴" FontSize="17" Margin="0,0,8,0" />
                                <TextBlock Text="最近打开" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AllAppsButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="AllAppsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦" FontSize="17" Margin="0,0,8,0" />
                                <TextBlock Text="全部应用" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="AddFileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▱" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="添加文件" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="AddFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▰" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="添加文件夹" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Click="EverythingButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌕" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="Everything" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsButton"
                                Content="⚙"
                                Style="{StaticResource RoundIconButtonStyle}"
                                FontFamily="Segoe UI Symbol"
                                FontSize="18"
                                ToolTip="外观设置"
                                Click="SettingsButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="350" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="24"
                        Background="{DynamicResource PrimaryPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="▰"
                                           Foreground="{DynamicResource BlueBrush}"
                                           FontSize="24"
                                           Margin="0,0,14,0" />
                                <TextBlock Text="我的堆栈"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ListBox x:Name="FavoriteGroupList"
                                     Grid.Column="1"
                                     Margin="18,0,10,0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     ItemTemplate="{StaticResource GroupChipTemplate}"
                                     ItemContainerStyle="{StaticResource GroupChipListBoxItemStyle}"
                                     SelectionMode="Single"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="FavoriteGroupList_PreviewMouseLeftButtonDown"
                                     PreviewMouseRightButtonDown="FavoriteGroupList_PreviewMouseRightButtonDown"
                                     PreviewMouseMove="FavoriteGroupList_PreviewMouseMove"
                                     DragOver="FavoriteGroupList_DragOver"
                                     DragLeave="FavoriteGroupList_DragLeave"
                                     Drop="FavoriteGroupList_Drop"
                                     GiveFeedback="FavoriteGroupList_GiveFeedback"
                                     SelectionChanged="FavoriteGroupList_SelectionChanged">
                                <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                            <Button x:Name="AddFavoriteGroupButton"
                                    Grid.Column="2"
                                    Width="38"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Content="+"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    MinWidth="38"
                                    Padding="0"
                                    FontSize="20"
                                    ToolTip="新增分组"
                                    Click="AddFavoriteGroupButton_Click" />

                            <Border Grid.Column="3"
                                    CornerRadius="9"
                                    Background="{DynamicResource MutedPanelBrush}"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="FavoriteCountText"
                                           Foreground="#667085"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>

                            <Popup x:Name="NewGroupPopup"
                                   PlacementTarget="{Binding ElementName=AddFavoriteGroupButton}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False">
                                <Border Width="220"
                                        Margin="0,8,0,0"
                                        CornerRadius="16"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10"
                                        Effect="{StaticResource SoftShadow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewGroupNameBox"
                                                 Height="34"
                                                 Padding="10,7"
                                                 VerticalContentAlignment="Center"
                                                 PreviewKeyDown="NewGroupNameBox_PreviewKeyDown" />
                                        <Button Grid.Column="1"
                                                Height="34"
                                                Margin="8,0,0,0"
                                                Content="添加"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                MinWidth="50"
                                                Padding="8,0"
                                                Click="CreateFavoriteGroupButton_Click" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ListBox x:Name="FavoritesList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemTemplate="{StaticResource FavoriteTileTemplate}"
                                     AllowDrop="True"
                                     SelectionMode="Single"
                                     ToolTip="可直接拖入桌面图标、文件或文件夹"
                                     PreviewMouseLeftButtonDown="FavoritesList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FavoritesList_PreviewMouseMove"
                                     DragOver="FavoritesList_DragOver"
                                     DragLeave="FavoritesList_DragLeave"
                                     Drop="FavoritesList_Drop"
                                     GiveFeedback="FavoritesList_GiveFeedback"
                                     MouseDoubleClick="FavoritesList_MouseDoubleClick"
                                     PreviewKeyDown="List_PreviewKeyDown">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Left" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource PanelSplitterStyle}" />

                <Border Grid.Column="2"
                        CornerRadius="24"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="18"
                        AllowDrop="True"
                        DragOver="FolderStack_DragOver"
                        Drop="FolderStack_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Border DockPanel.Dock="Right"
                                    CornerRadius="9"
                                    Background="{DynamicResource MutedPanelBrush}"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="FolderCountText"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▰"
                                           Foreground="{DynamicResource BlueBrush}"
                                           FontSize="23"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="文件夹"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="FolderItemsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     AllowDrop="True"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemTemplate="{StaticResource FolderItemTemplate}"
                                     PreviewMouseLeftButtonDown="FolderItemsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="FolderItemsList_PreviewMouseMove"
                                     DragOver="FolderStack_DragOver"
                                     DragLeave="FolderItemsList_DragLeave"
                                     Drop="FolderStack_Drop"
                                     GiveFeedback="FolderItemsList_GiveFeedback"
                                     MouseDoubleClick="FolderItemsList_MouseDoubleClick"
                                     PreviewKeyDown="List_PreviewKeyDown" />

                            <StackPanel x:Name="FolderEmptyPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20"
                                        Visibility="Collapsed">
                                <TextBlock Text="暂无文件夹"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="点击上方「添加文件夹」后会显示在这里"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="2"
                                Height="44"
                                Margin="0,14,0,0"
                                Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                Foreground="{DynamicResource SubTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="AddFolderButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="添加文件夹" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    CornerRadius="14"
                    Background="{DynamicResource StatusPanelBrush}"
                    BorderBrush="{DynamicResource StatusBorderBrush}"
                    BorderThickness="1"
                    Padding="14,11"
                    Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="Bold"
                               Margin="0,0,10,0" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource SubTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Popup x:Name="RecentFilesPopup"
                   PlacementTarget="{Binding ElementName=RecentFilesButton}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Width="500"
                        Height="520"
                        CornerRadius="24"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="18"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="×"
                                    Style="{StaticResource RoundIconButtonStyle}"
                                    FontSize="18"
                                    Margin="0"
                                    ToolTip="关闭"
                                    Click="CloseRecentFilesPopupButton_Click" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◴"
                                           Foreground="{DynamicResource BlueBrush}"
                                           FontSize="23"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="最近打开"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <ListBox x:Name="RecentItemsList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ItemTemplate="{StaticResource RecentItemTemplate}"
                                     MouseDoubleClick="RecentItemsList_MouseDoubleClick"
                                     PreviewKeyDown="List_PreviewKeyDown" />

                            <StackPanel x:Name="RecentEmptyPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20"
                                        Visibility="Collapsed">
                                <TextBlock Text="暂无最近文件"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Windows 最近项目为空，或系统已关闭最近项目记录"
                                           Margin="0,8,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Button Grid.Row="2"
                                Height="44"
                                Margin="0,14,0,0"
                                Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                Foreground="{DynamicResource SubTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="ReloadRecentFilesButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="↻" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="重新读取" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="AllAppsPopup"
                   PlacementTarget="{Binding ElementName=AllAppsButton}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Width="520"
                        Height="570"
                        CornerRadius="24"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="18"
                        Effect="{StaticResource SoftShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right"
                                    Content="×"
                                    Style="{StaticResource RoundIconButtonStyle}"
                                    FontSize="18"
                                    Margin="0"
                                    ToolTip="关闭"
                                    Click="CloseAllAppsPopupButton_Click" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▦"
                                           Foreground="{DynamicResource BlueBrush}"
                                           FontSize="23"
                                           Margin="0,0,12,0" />
                                <TextBlock Text="全部应用"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>

                        <TextBox x:Name="SearchBox"
                                 Grid.Row="1"
                                 Margin="0,0,0,10"
                                 TextChanged="SearchBox_TextChanged"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />

                        <ListBox x:Name="AllItemsList"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemTemplate="{StaticResource AllItemTemplate}"
                                 MouseDoubleClick="AllItemsList_MouseDoubleClick"
                                 PreviewKeyDown="List_PreviewKeyDown" />

                        <Button Grid.Row="3"
                                Height="44"
                                Margin="0,14,0,0"
                                Background="{DynamicResource ToolbarBrush}"
                                BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                Foreground="{DynamicResource SubTextBrush}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="FocusSearchButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⌕" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="搜索全部应用" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="SettingsPopup"
                   PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   StaysOpen="False">
                <Border Width="390"
                        CornerRadius="24"
                        Background="{DynamicResource SecondaryPanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Effect="{StaticResource SoftShadow}">
                    <ScrollViewer MaxHeight="620"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="设置"
                                   Margin="4,0,0,14"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />

                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="16">
                            <DockPanel>
                                <ComboBox x:Name="ThemeModeComboBox"
                                          DockPanel.Dock="Right"
                                          Width="116"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock Text="主题模式"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="选择浅色、深色或跟随 Windows 设置"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <CheckBox x:Name="GlassToggle"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource SwitchStyle}"
                                              Checked="GlassToggle_Changed"
                                              Unchecked="GlassToggle_Changed" />
                                    <StackPanel>
                                        <TextBlock Text="透明面板"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="控制窗口背景的通透程度"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="透明度"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="1"
                                            Style="{StaticResource IOSSliderStyle}"
                                            Minimum="0.55"
                                            Maximum="1"
                                            TickFrequency="0.05"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock x:Name="StackIconSizeValueText"
                                               DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="堆栈图标大小"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="调整我的堆栈中图标和名称的显示尺寸"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="StackIconSizeSlider"
                                        Grid.Row="2"
                                        Style="{StaticResource IOSSliderStyle}"
                                        Minimum="30"
                                        Maximum="70"
                                        TickFrequency="4"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="StackIconSizeSlider_ValueChanged" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="0,12,0,0">
                            <DockPanel>
                                <CheckBox x:Name="StartupToggle"
                                          DockPanel.Dock="Right"
                                          Style="{StaticResource SwitchStyle}"
                                          Checked="StartupToggle_Changed"
                                          Unchecked="StartupToggle_Changed" />
                                <StackPanel>
                                    <TextBlock Text="开机自启"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="登录 Windows 后自动启动 QuickShelf"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SubTextBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="全部应用"
                                   Margin="4,16,0,8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="14">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="CompactAllAppsToggle"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource SwitchStyle}"
                                              Checked="AllAppsSetting_Changed"
                                              Unchecked="AllAppsSetting_Changed" />
                                    <StackPanel>
                                        <TextBlock Text="精简列表"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Text="隐藏重复项、网页壳和更新/卸载入口"
                                                   Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel x:Name="CompactAllAppsOptionsPanel">
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13,0,12" />

                                    <DockPanel>
                                        <CheckBox x:Name="HideShortcutItemsToggle"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="AllAppsSetting_Changed"
                                                  Unchecked="AllAppsSetting_Changed" />
                                        <TextBlock Text="过滤 .lnk 快捷方式"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </DockPanel>

                                    <DockPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="ShowStartMenuToggle"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="AllAppsSetting_Changed"
                                                  Unchecked="AllAppsSetting_Changed" />
                                        <TextBlock Text="开始菜单应用"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </DockPanel>

                                    <DockPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="ShowRegistryToggle"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="AllAppsSetting_Changed"
                                                  Unchecked="AllAppsSetting_Changed" />
                                        <TextBlock Text="注册表应用"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </DockPanel>

                                    <DockPanel Margin="0,10,0,0">
                                        <CheckBox x:Name="ShowAppsFolderToggle"
                                                  DockPanel.Dock="Right"
                                                  Style="{StaticResource SwitchStyle}"
                                                  Checked="AllAppsSetting_Changed"
                                                  Unchecked="AllAppsSetting_Changed" />
                                        <TextBlock Text="Windows 应用入口"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SubTextBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="主题颜色"
                                   Margin="4,16,0,8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="14">
                            <UniformGrid Columns="6">
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#2F7CF6"
                                        Tag="#2F7CF6"
                                        ToolTip="蓝色"
                                        Click="ThemeColorButton_Click" />
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#10B981"
                                        Tag="#10B981"
                                        ToolTip="绿色"
                                        Click="ThemeColorButton_Click" />
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#F97316"
                                        Tag="#F97316"
                                        ToolTip="橙色"
                                        Click="ThemeColorButton_Click" />
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#EF4444"
                                        Tag="#EF4444"
                                        ToolTip="红色"
                                        Click="ThemeColorButton_Click" />
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#8B5CF6"
                                        Tag="#8B5CF6"
                                        ToolTip="紫色"
                                        Click="ThemeColorButton_Click" />
                                <Button Style="{StaticResource ColorSwatchButtonStyle}"
                                        Background="#0F172A"
                                        Tag="#0F172A"
                                        ToolTip="深色"
                                        Click="ThemeColorButton_Click" />
                            </UniformGrid>
                        </Border>

                        <TextBlock Text="快捷键"
                                   Margin="4,16,0,8"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubTextBrush}" />
                        <Border CornerRadius="18"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="HotKeySummaryText"
                                           Foreground="{DynamicResource SubTextBrush}"
                                           FontSize="12" />
                                <TextBox x:Name="HotKeyCaptureBox"
                                         Margin="0,10,0,0"
                                         Height="40"
                                         IsReadOnly="True"
                                         Cursor="IBeam"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         PreviewKeyDown="HotKeyCaptureBox_PreviewKeyDown"
                                         GotKeyboardFocus="HotKeyCaptureBox_GotKeyboardFocus" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
